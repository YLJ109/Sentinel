# ============================================================================
# 守望 Sentinel · 校园反霸凌智能检测系统 · 环境变量样例
# 用法：复制为 backend/.env 后按实际环境填写；.env 不应提交到代码仓库。
# 所有变量均可通过环境变量直接注入，适合容器化部署。
# ============================================================================

# ---------- 基础 ----------
CAB_DEBUG=false
# 运行环境：development / production。
# 设为 production 时会强制校验：SECRET_KEY 必须替换、CORS 不得含通配符、媒体 Cookie 必须 Secure
CAB_ENV=development
# 生产环境必须替换为 32 位以上随机串
CAB_SECRET_KEY=change-me-in-production-please-use-32+chars
CAB_ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 安全 ----------
# 允许访问的前端来源（逗号分隔或 JSON 数组），生产禁止使用 "*"
CAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 取证媒体走 HttpOnly Cookie 鉴权；HTTPS 部署后置为 true
CAB_MEDIA_COOKIE_SECURE=false
# 登录失败保护：窗口内失败次数 / 统计窗口 / 锁定时长（秒）
CAB_LOGIN_MAX_FAILURES=5
CAB_LOGIN_FAILURE_WINDOW_SEC=300
CAB_LOGIN_LOCKOUT_SEC=300

# ---------- 推理设备 ----------
# auto：有 CUDA 用 GPU，否则用 CPU；也可固定为 cuda:0 / cpu
CAB_DEVICE=auto
CAB_HALF=true
CAB_IMGSZ=640
CAB_INFER_FPS_LIMIT=12
CAB_ENABLE_POSE=true

# ---------- 性能：运动门控与任务并发 ----------
# 画面几乎静止时跳过推理，显著降低空场景算力占用
CAB_MOTION_GATE_ENABLED=true
CAB_MOTION_DIFF_THRESHOLD=1.2
CAB_MOTION_GATE_FORCE_INTERVAL_SEC=2.0
# 视频文件分析的并发上限（GPU 显存有限，默认串行）
CAB_VIDEO_WORKER_CONCURRENCY=1

# ---------- 视觉模型权重 ----------
# 相对名会定位到 backend/models/ 下，缺失时自动从官方源下载
CAB_YOLO_DETECT_WEIGHTS=yolov8n.pt
CAB_YOLO_POSE_WEIGHTS=yolov8n-pose.pt
# 自定义行为模型（吸烟/打架专用类别）。用 scripts/train_behavior.py 训练产出后填写文件名
CAB_YOLO_BEHAVIOR_WEIGHTS=

# ---------- 人脸检测（仅定位人脸框，不做人脸识别/比对）----------
CAB_ENABLE_FACE=true
# 留空：使用 OpenCV 自带 Haar 级联，随 opencv 安装、完全离线可用；
# 想提升召回与准确率：下载开源 YOLO 人脸权重（如 yolov8n-face.pt）放到 backend/models/ 下，
# 然后在这里填文件名即可自动切换为模型检测
CAB_FACE_MODEL=
CAB_FACE_CONF=0.45
CAB_FACE_MIN_RATIO=0.06
CAB_FACE_MAX_FACES=30

# ---------- 检测阈值（按现场视角标定）----------
CAB_DETECT_CONF=0.35
CAB_FALL_ASPECT_RATIO=1.05
CAB_FALL_TORSO_ANGLE=52
CAB_FIGHT_DIST_RATIO=1.75
CAB_FIGHT_WRIST_SPEED=0.62
CAB_ARGUE_DIST_RATIO=2.2

# ---------- 报警策略 ----------
CAB_ALARM_MIN_CONFIDENCE=0.55
CAB_ALARM_COOLDOWN_SEC=8
CAB_ALARM_MERGE_WINDOW_SEC=5
# 冷却/去重状态在 SQLite 中的存活时间（保证多 worker 与重启后行为一致）
CAB_ALARM_STATE_TTL_SEC=3600

# ---------- 报警外发通知（可选）----------
# 企业微信 / 钉钉机器人或自建网关的 Webhook 地址；留空则不外发
CAB_NOTIFY_WEBHOOK_URL=
# 仅推送不低于该级别的报警：high / medium / low
CAB_NOTIFY_MIN_LEVEL=high
CAB_NOTIFY_TIMEOUT_SEC=5.0

# ---------- 语音识别（云端为主）----------
CAB_SPEECH_ENABLED=true
# dashscope：阿里云百炼 Paraformer 实时识别（推荐，只需一个 API Key）；
# aliyun：阿里云智能语音交互 NLS（需 AppKey + Token/AccessKey）；vosk：本地离线兜底
CAB_ASR_PROVIDER=dashscope
CAB_SPEECH_SAMPLE_RATE=16000

# --- 阿里云百炼（DashScope）实时语音识别 ---
# 百炼控制台 → API-KEY（sk- 开头）填入即可
CAB_DASHSCOPE_API_KEY=
CAB_DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
CAB_DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# --- 阿里云智能语音交互（NLS）---
# 注意：与上面的百炼是两套完全不同的接入，凭据不通用；CAB_ASR_PROVIDER=aliyun 时才会用到
# 在智能语音交互控制台创建项目后获得 AppKey
CAB_ALIYUN_NLS_APPKEY=
# 方式一：提供 AccessKey，服务端自动换取并缓存 Token（需 RAM 最小权限）
CAB_ALIYUN_ACCESS_KEY_ID=
CAB_ALIYUN_ACCESS_KEY_SECRET=
# 方式二：由外部令牌服务签发短期 Token，免于在应用内放置长期凭据（推荐）
CAB_ALIYUN_NLS_TOKEN=
CAB_ALIYUN_NLS_REGION=cn-shanghai
CAB_ALIYUN_NLS_ENDPOINT=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1

# ---------- 取证与留存 ----------
CAB_EVIDENCE_KEEP_DAYS=90
CAB_EVIDENCE_JPEG_QUALITY=88
# 报警视频片段：报警前预录 / 报警后延录 / 实时预录环形缓冲帧数
CAB_CLIP_PRE_SECONDS=3
CAB_CLIP_POST_SECONDS=5
CAB_CLIP_RING_CAPACITY=48
# 留存清理任务：是否启用与执行间隔（秒）
CAB_RETENTION_ENABLED=true
CAB_RETENTION_INTERVAL_SEC=21600
